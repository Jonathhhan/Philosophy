{
  "description": "Run the Recursive Codex closure check before a turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/recursive_stop.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$repo = git rev-parse --show-toplevel; python -B (Join-Path $repo '.codex\\hooks\\recursive_stop.py')\"",
            "timeout": 30,
            "statusMessage": "Prüfe rekursiven Projektabschluss"
          }
        ]
      }
    ]
  }
}
